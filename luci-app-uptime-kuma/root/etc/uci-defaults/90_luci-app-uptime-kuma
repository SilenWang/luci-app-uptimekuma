#!/bin/sh
# First-run hook: let the LAN reach the Uptime Kuma panel.
#
#   /etc/uci-defaults/90_luci-app-uptime-kuma
#
# The panel speaks plain HTTP on a port of its own, and the default OpenWrt
# firewall drops input on the LAN zone, so a fresh install looks broken even
# though the service is up. Open exactly one TCP port, from the LAN zone only;
# the WAN side stays closed.
#
# Runs once: /etc/init.d/boot executes the files in /etc/uci-defaults and
# removes them, and the package postinst runs (and removes) this one right
# after unpacking. The script is idempotent - an existing rule of that name,
# possibly edited by the operator, is never touched again - and always exits 0
# so neither path treats it as failed.

[ -f /etc/config/firewall ] || exit 0

# The rule's port and listen address come from the service configuration. If
# that file is not there yet (offline install order), fail so /etc/init.d/boot
# keeps this hook around for the next boot instead of silently opening nothing.
if [ ! -f /etc/config/uptime-kuma ]; then
	echo "90_luci-app-uptime-kuma: /etc/config/uptime-kuma missing, retrying on next boot" >&2
	exit 1
fi

# Fixed section name so a second run can recognise its own rule. UCI section
# names are alphanumerics and underscores.
NAME=uptime_kuma

uci -q get firewall.$NAME >/dev/null && exit 0

# `enabled=0` means the operator does not want the service at boot; do not
# punch a hole for something that is not supposed to listen.
ENABLED=$(uci -q get uptime-kuma.main.enabled)
[ "$ENABLED" = "0" ] && exit 0

PORT=$(uci -q get uptime-kuma.main.port)
PORT=${PORT:-3001}

# `listen=127.0.0.1` (or ::1) means the panel is deliberately local-only, so
# no inbound rule is wanted. Anything else - including the default 0.0.0.0 -
# is meant to be reachable from the LAN.
LISTEN=$(uci -q get uptime-kuma.main.listen)
case "$LISTEN" in
	127.*|::1|localhost)
		exit 0
		;;
esac

uci -q batch <<-EOF
	set firewall.$NAME=rule
	set firewall.$NAME.name='Allow-uptime-kuma'
	set firewall.$NAME.src='lan'
	set firewall.$NAME.proto='tcp'
	set firewall.$NAME.dest_port='$PORT'
	set firewall.$NAME.target='ACCEPT'
EOF

uci -q commit firewall

# No reload here on purpose: at boot this hook runs before /etc/init.d/firewall
# starts, and the committed rule is picked up by that very start. Installing the
# package on a running system reloads the firewall from postinst instead.

exit 0
