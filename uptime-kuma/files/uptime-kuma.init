#!/bin/sh /etc/rc.common
# Uptime Kuma service (procd).
#
# Node comes from the node20 package; this package only carries the app.
# The app resolves ./dist relative to its working directory, so cwd matters.

START=99
STOP=10
USE_PROCD=1

PROG=/opt/node20/bin/node
APP_DIR=/opt/uptime-kuma

start_service() {
	local enabled listen port data_dir tz

	config_load uptime-kuma
	config_get_bool enabled main enabled 0
	config_get listen main listen '0.0.0.0'
	config_get port main port '3001'
	config_get data_dir main data_dir "$APP_DIR/data"
	config_get tz main tz 'UTC'

	[ "$enabled" = "1" ] || return 0
	if [ ! -x "$PROG" ]; then
		logger -t uptime-kuma "missing $PROG (install the node20 package)"
		return 1
	fi

	mkdir -p "$data_dir"

	procd_open_instance
	procd_set_param command "$PROG" server/server.js
	procd_set_param cwd "$APP_DIR"
	# UPTIME_KUMA_HOST, not HOST: server/config.js also reads the system HOST.
	procd_set_param env \
		NODE_ENV=production \
		UPTIME_KUMA_HOST="$listen" \
		UPTIME_KUMA_PORT="$port" \
		DATA_DIR="$data_dir" \
		TZ="$tz" \
		LD_LIBRARY_PATH="$APP_DIR/lib"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger uptime-kuma
}

reload_service() {
	restart
}
