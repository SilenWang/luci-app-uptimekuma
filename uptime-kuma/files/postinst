#!/bin/sh
# Make sure /etc/config/uptime-kuma exists.
#
# opkg unpacks the conffile on a clean install, but a previous `opkg remove`
# (which deletes an unmodified conffile) followed by a reinstall that trips
# "modified conffile" can leave the box without it. Without the file the init
# script reads enabled=0 and the service silently never starts, which looks
# exactly like "the package is installed but nothing happens".

[ -n "${IPKG_INSTROOT}" ] && exit 0

if [ ! -f /etc/config/uptime-kuma ]; then
	uci -q batch <<-EOF
	set uptime-kuma.main=uptime-kuma
	set uptime-kuma.main.enabled='1'
	set uptime-kuma.main.listen='0.0.0.0'
	set uptime-kuma.main.port='3001'
	set uptime-kuma.main.data_dir='/opt/uptime-kuma/data'
	set uptime-kuma.main.tz='UTC'
	EOF
	uci -q commit uptime-kuma
fi

# `opkg upgrade` removes the old payload before unpacking the new one, so the
# service is down and the /etc/rc.d links are gone afterwards. Bring it back
# when the operator has it enabled -- otherwise every upgrade silently leaves
# Uptime Kuma stopped until someone notices.
if [ "$(uci -q get uptime-kuma.main.enabled)" = "1" ]; then
	/etc/init.d/uptime-kuma enable >/dev/null 2>&1
	/etc/init.d/uptime-kuma start >/dev/null 2>&1
fi

exit 0
